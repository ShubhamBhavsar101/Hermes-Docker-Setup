# =======================================================
# Hermes Agent Environment Configuration
# =======================================================

# Web Dashboard Credentials
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=SecretPass999

# Preferred Provider: OpenRouter (Free models available)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Other Optional Cloud Providers
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENAI_API_KEY=sk-proj-xxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# GROQ_API_KEY=gsk_xxxxxxxx

# Local Models (Ollama / LM Studio)
# Reach host services at http://host.docker.internal:<port>/v1
# Ollama: http://host.docker.internal:11434/v1
# LM Studio: http://host.docker.internal:1234/v1
